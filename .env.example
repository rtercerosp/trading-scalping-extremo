# Archivo de configuración de ejemplo para el Framework de Trading v1.1

# --- Credenciales de Conexión a MetaTrader 5 ---
# Ruta al ejecutable de MetaTrader 5. Usa dobles barras invertidas en Windows.
MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
MT5_LOGIN=12345678
MT5_PASSWORD="TU_PASSWORD_DE_TRADING"
MT5_SERVER="TU_SERVIDOR_DE_BROKER"
MT5_TIMEOUT=60000
MT5_PORTABLE=False

# --- Credenciales de Notificaciones por Telegram (Opcional) ---
TELEGRAM_TOKEN="TU_TOKEN_DE_BOT_DE_TELEGRAM"
TELEGRAM_CHAT_ID="TU_CHAT_ID_DE_TELEGRAM"

# --- Símbolos de Trading ---
# Esta línea será rellenada automáticamente al ejecutar el script 'discover_symbols.py'
TRADING_SYMBOLS=""